{
  "name": "momoko-pro",
  "version": "0.1.0",
  "private": true,
  "description": "momoko.pro — 非官方周防桃子 fan site（Git canonical + 静态构建）",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:post": "node --experimental-strip-types tools/schema/postbuild.ts",
    "build:verify": "node tools/schema/determinism.mjs",
    "check": "astro check",
    "test": "vitest run",
    "test:schema": "vitest run tests/schema.test.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "astro": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
