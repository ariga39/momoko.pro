{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momoko.pro/schemas/reviewers.schema.json",
  "title": "reviewer 允许名单（config/reviewers.json，真实 GitHub 身份）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "reviewers"],
  "properties": {
    "schema_version": { "const": "1" },
    "$comment": { "type": "string" },
    "reviewers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
      }
    }
  }
}
