{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momoko.pro/schemas/anniversary.schema.json",
  "title": "纪念日结构化事实（T0）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "slug", "date", "title", "tier",
    "source_id", "source_url"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "kind": { "enum": ["birthday", "anniversary", "release"] },
    "slug": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "title": { "type": "string", "minLength": 1 },
    "tier": { "const": "T0" },
    "source_id": { "$ref": "source.schema.json#/$defs/source_id" },
    "source_url": { "type": "string", "format": "uri" },
    "notes": { "type": "string" }
  }
}
