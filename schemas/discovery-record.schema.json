{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://momoko.pro/schemas/discovery-record.schema.json",
 "title": "人工发现记录（manual-import 输入）",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "source_id",
  "source_item_id",
  "source_url",
  "published_at",
  "title",
  "lang",
  "note"
 ],
 "properties": {
  "schema_version": {
   "const": "1"
  },
  "source_id": {
   "$ref": "source.schema.json#/$defs/source_id"
  },
  "source_item_id": {
   "type": "string",
   "minLength": 1,
   "maxLength": 200
  },
  "source_url": {
   "type": "string",
   "format": "uri"
  },
  "published_at": {
   "type": "string",
   "format": "date-time"
  },
  "title": {
   "type": "string",
   "minLength": 1
  },
  "lang": {
   "enum": [
    "ja",
    "zh",
    "en"
   ]
  },
  "note_hash": {
   "type": "string",
   "pattern": "^sha256:[a-f0-9]{64}$"
  },
  "note": {
   "type": "string",
   "minLength": 1
  }
 }
}
