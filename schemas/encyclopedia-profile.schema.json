{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momoko.pro/schemas/encyclopedia-profile.schema.json",
  "title": "encyclopedia profile（canonical；facts 严格来自冻结 task #50 inventory）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "kind", "source_id", "source_item_id", "retrieved_at",
    "content_hash", "risk_tier", "lang", "is_canonical", "title", "source_url",
    "body", "review_status",
    "name_ja", "name_roman", "cv", "affiliation", "type",
    "age", "birthday", "blood_type", "constellation", "handedness",
    "height", "weight", "three_sizes", "birthplace", "hobby", "specialty", "likes", "tagline"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "kind": { "const": "wiki" },
    "source_id": { "$ref": "source.schema.json#/$defs/source_id" },
    "source_item_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "retrieved_at": { "type": "string", "format": "date" },
    "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "risk_tier": { "enum": ["T0", "T1", "T2"] },
    "lang": { "const": "ja" },
    "is_canonical": { "const": true },
    "title": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "body": { "type": "string" },
    "review_status": { "enum": ["draft", "reviewed", "stale", "retracted"] },
    "reviewed_by": { "type": ["string", "null"] },
    "reviewed_at": { "type": ["string", "null"], "format": "date-time" },
    "name_ja": { "type": "string", "minLength": 1 },
    "name_roman": { "type": "string", "minLength": 1 },
    "cv": { "type": "string", "minLength": 1 },
    "affiliation": { "type": "string", "minLength": 1 },
    "type": { "type": "string", "minLength": 1 },
    "age": { "type": "string", "minLength": 1 },
    "birthday": { "type": "string", "minLength": 1 },
    "blood_type": { "type": "string", "minLength": 1 },
    "constellation": { "type": "string", "minLength": 1 },
    "handedness": { "type": "string", "minLength": 1 },
    "height": { "type": "string", "minLength": 1 },
    "weight": { "type": "string", "minLength": 1 },
    "three_sizes": { "type": "string", "minLength": 1 },
    "birthplace": { "type": "string", "minLength": 1 },
    "hobby": { "type": "string", "minLength": 1 },
    "specialty": { "type": "string", "minLength": 1 },
    "likes": { "type": "string", "minLength": 1 },
    "tagline": { "type": "string", "minLength": 1 }
  },
  "if": { "properties": { "review_status": { "const": "reviewed" } } },
  "then": {
    "properties": {
      "reviewed_by": { "type": "string", "minLength": 1 },
      "reviewed_at": { "type": "string", "format": "date-time" }
    },
    "required": ["reviewed_by", "reviewed_at"]
  }
}
