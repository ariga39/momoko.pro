{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momoko.pro/schemas/source.schema.json",
  "title": "来源配置（config/sources.json）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "const": "1" },
    "$comment": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source_id": {
      "type": "string",
      "pattern": "^S[0-9]+$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "evidence"],
      "properties": {
        "allowed": { "type": "boolean" },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "项目/owner 的明确核验证据（如 robots 文本段落 / 条款链接与摘录 + 核验时间）；协议状态本身不是授权，缺失不得视为允许"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "name_zh", "canonical_url", "robots_txt_url", "robots_http", "robots_note", "terms_url", "terms_note", "automated_fetch", "fetch_frequency", "cache_boundary", "stop_condition"],
      "properties": {
        "source_id": { "$ref": "#/$defs/source_id" },
        "name_zh": { "type": "string" },
        "canonical_url": { "type": "string", "format": "uri" },
        "robots_txt_url": { "type": ["string", "null"], "format": "uri" },
        "robots_http": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{3}$",
          "description": "Legacy observation only; runtime decisions use the explicit robots_result and robots_path_decision fields"
        },
        "robots_result": {
          "type": "string",
          "enum": ["rules_available", "unavailable", "unreachable", "not_applicable"],
          "description": "RFC 9309 result class, independent of any one target path"
        },
        "robots_path_decision": {
          "type": "string",
          "enum": ["allow", "disallow", "no_match", "not_evaluated"],
          "description": "Decision for checked_path only; never a whole-site permission"
        },
        "checked_path": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "The URL path to which robots_path_decision applies; null only when not_applicable"
        },
        "retrieved_at": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Evidence date or timestamp for the robots result; null only when not_applicable"
        },
        "evidence": {
          "type": ["string", "null"],
          "minLength": 1,
          "description": "Human-readable evidence bound to the result and checked path"
        },
        "fetch_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/(?:[^?#]*)$"
          },
          "description": "Explicit URL paths an automated adapter may request; each path is checked independently"
        },
        "robots_note": { "type": "string" },
        "terms_url": { "type": ["string", "null"], "format": "uri" },
        "terms_note": { "type": "string" },
        "robots_approved": {
          "$ref": "#/$defs/approval",
          "deprecated": true,
          "description": "Deprecated compatibility field; retained for old configs and ignored by new access decisions"
        },
        "terms_approved": { "$ref": "#/$defs/approval" },
        "automated_fetch": { "type": "boolean" },
        "fetch_frequency": { "enum": ["manual", "daily", "weekly"] },
        "cache_boundary": { "type": "string" },
        "stop_condition": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "automated_fetch": { "const": true } } },
          "then": {
            "properties": {
              "fetch_frequency": { "not": { "const": "manual" } }
            },
            "required": ["fetch_paths"]
          }
        },
        {
          "if": { "properties": { "automated_fetch": { "const": false } } },
          "then": { "properties": { "fetch_frequency": { "const": "manual" } } }
        },
        {
          "if": {
            "required": ["robots_result"],
            "properties": { "robots_result": { "const": "rules_available" } }
          },
          "then": {
            "required": ["robots_path_decision", "checked_path", "retrieved_at", "evidence"],
            "properties": {
              "robots_path_decision": { "enum": ["allow", "disallow", "no_match"] }
            }
          }
        },
        {
          "if": {
            "required": ["robots_result"],
            "properties": { "robots_result": { "const": "unavailable" } }
          },
          "then": {
            "required": ["robots_path_decision", "checked_path", "retrieved_at", "evidence"],
            "properties": {
              "robots_path_decision": { "const": "allow" }
            }
          }
        },
        {
          "if": {
            "required": ["robots_result"],
            "properties": { "robots_result": { "const": "unreachable" } }
          },
          "then": {
            "required": ["robots_path_decision", "checked_path", "retrieved_at", "evidence"],
            "properties": {
              "robots_path_decision": { "const": "disallow" }
            }
          }
        },
        {
          "if": {
            "required": ["robots_result"],
            "properties": { "robots_result": { "const": "not_applicable" } }
          },
          "then": {
            "required": ["robots_path_decision", "checked_path", "retrieved_at", "evidence"],
            "properties": {
              "robots_path_decision": { "const": "not_evaluated" },
              "checked_path": { "const": null },
              "retrieved_at": { "const": null },
              "evidence": { "const": null }
            }
          }
        }
      ]
    }
  }
}
