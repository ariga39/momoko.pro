{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momoko.pro/schemas/manifest.schema.json",
  "title": "manifest.json（deterministic build artifact，不提交仓库）",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "generated_at", "entries"],
  "properties": {
    "manifest_version": { "type": "string", "pattern": "^[0-9]+$" },
    "generated_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "kind", "source_id", "source_item_id", "content_hash",
        "review_status", "locales"
      ],
      "properties": {
        "path": { "type": "string", "pattern": "^content/.*/index\\.md$" },
        "kind": { "enum": ["news", "wiki", "anniversary", "live"] },
        "source_id": { "$ref": "source.schema.json#/$defs/source_id" },
        "source_item_id": { "type": "string" },
        "content_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "review_status": { "enum": ["draft", "reviewed", "published", "stale", "retracted"] },
        "locales": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ja", "zh", "en"],
          "properties": {
            "ja": { "$ref": "#/$defs/locale_state" },
            "zh": { "$ref": "#/$defs/locale_state" },
            "en": { "$ref": "#/$defs/locale_state" }
          }
        },
        "retracted_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "locale_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "hash", "reviewed_by"],
      "properties": {
        "status": { "enum": ["draft", "reviewed", "published", "stale", "retracted"] },
        "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "reviewed_by": { "type": ["string", "null"] },
        "stale_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
