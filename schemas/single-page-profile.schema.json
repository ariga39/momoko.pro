{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://momoko.pro/schemas/single-page-profile.schema.json",
  "title": "official-single-page 来源 profile（声明式、可校验；禁止 eval/递归 key 搜索/相似字段 fallback）",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_id", "canonical_url", "origin", "automated_fetch", "limits", "selector"],
  "properties": {
    "schema_version": { "const": "1" },
    "source_id": { "$ref": "source.schema.json#/$defs/source_id" },
    "canonical_url": { "type": "string", "format": "uri" },
    "origin": { "type": "string", "format": "uri" },
    "automated_fetch": { "const": false },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_bytes", "deadline_ms", "max_redirects", "allowed_content_types"],
      "properties": {
        "max_bytes": { "type": "integer", "minimum": 1 },
        "deadline_ms": { "type": "integer", "minimum": 1 },
        "max_redirects": { "type": "integer", "minimum": 0 },
        "allowed_content_types": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_path", "fields"],
      "properties": {
        "root_path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "fields": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/field" },
          "propertyNames": { "pattern": "^[a-zA-Z0-9_.-]+$" },
          "minProperties": 1
        }
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["string"] },
        "map_to": {
          "enum": ["source_item_id", "source_url", "title", "lang", "published_at"]
        },
        "const": { "type": "string" },
        "min_length": { "type": "integer", "minimum": 0 },
        "value_format": { "enum": ["dspdate_iso_jst"] }
      },
      "allOf": [
        {
          "if": { "required": ["value_format"] },
          "then": { "properties": { "map_to": { "const": "published_at" } } }
        }
      ]
    }
  }
}
