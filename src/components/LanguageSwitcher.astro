---
import { ml, type Locale } from "../lib/messages.ts";
import { localizePath } from "../lib/locale.ts";

interface Props {
  current: Locale;
  ariaLabel?: string;
}

const { current, ariaLabel } = Astro.props;
const t = ml(current);
const currentPath = `${Astro.url.pathname}${Astro.url.search}`;
const langs = [
  { code: "zh", label: t.langZh() },
  { code: "ja", label: t.langJa() },
  { code: "en", label: t.langEn() },
];
---

<nav aria-label={ariaLabel ?? t.navLanguage()}>
  <ul class="flex gap-2 text-sm">
    {langs.map((l) => (
      <li
        class={
          l.code !== "zh"
            ? "before:content-['·'] before:mr-2 before:text-text-secondary"
            : ""
        }
      >
        {l.code === current ? (
          <span aria-current="true" lang={l.code}>
            {l.label}
          </span>
        ) : (
          <a
            href={`/locale-switch?locale=${l.code}&next=${encodeURIComponent(localizePath(currentPath, l.code as Locale))}`}
            hreflang={l.code}
            lang={l.code}
            class="text-link"
          >
            {l.label}
          </a>
        )}
      </li>
    ))}
  </ul>
</nav>
