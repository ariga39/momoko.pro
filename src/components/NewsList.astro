---
import { loadPublishedNews, hasTranslation } from "../lib/content.ts";
import { ml, type Locale } from "../lib/messages.ts";
import NewsCard from "./NewsCard.astro";

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = ml(lang);
const items = loadPublishedNews().sort((a, b) =>
  b.canonical.publishedAt.localeCompare(a.canonical.publishedAt),
);
---

{items.length === 0 ? (
  <section aria-labelledby="empty-news-title" class="rounded border border-border bg-surface px-6 py-5">
    <h3 id="empty-news-title" class="mt-0 text-xl">{t.newsEmptyTitle()}</h3>
    <p>{t.newsEmpty()}</p>
  </section>
) : (
  <ul class="grid gap-6">
    {items.map((item) => (
      <NewsCard item={item} lang={lang} translated={hasTranslation(item, lang)} />
    ))}
  </ul>
)}
