---
import { getRelativeLocaleUrl } from "astro:i18n";
import "../styles/global.css";
import { ml, type Locale } from "../lib/messages.ts";
import LanguageSwitcher from "./LanguageSwitcher.astro";

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
  /** e.g. "noindex,follow" for fallback pages（design §1.2） */
  robots?: string;
  bodyData?: Record<string, string>;
  alternates?: Array<{ hreflang: string; href: string }>;
  /** x-default target；缺省为站点根。详情页按内容身份指向源语言页。 */
  xDefaultHref?: string;
}

const { lang, title, description, canonicalPath, noindex, robots, bodyData, alternates, xDefaultHref } =
  Astro.props;
const t = ml(lang);
const robotsContent = robots ?? (noindex ? "noindex" : undefined);
const nav = [
  { href: getRelativeLocaleUrl(lang, "/"), label: t.navNews() },
  { href: getRelativeLocaleUrl(lang, "/about/"), label: t.navAbout() },
  { href: getRelativeLocaleUrl(lang, "/source-policy/"), label: t.navSourcePolicy() },
  { href: "/search", label: t.navSearch() },
];
const canonical = canonicalPath ?? getRelativeLocaleUrl(lang, "/");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {robotsContent && <meta name="robots" content={robotsContent} />}
    {(alternates ?? [
      { hreflang: "zh", href: "https://momoko.pro/zh/" },
      { hreflang: "ja", href: "https://momoko.pro/ja/" },
      { hreflang: "en", href: "https://momoko.pro/en/" },
    ]).map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref ?? "https://momoko.pro/"} />
    <link rel="canonical" href={`https://momoko.pro${canonical}`} />
    <title>{title}</title>
  </head>
  <body {...(bodyData ?? {})}>
    <a class="skip-link" href="#main">{t.skipToContent()}</a>
    <header class="border-b border-border bg-surface">
      <div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-4 p-4">
        <a href="/" aria-label={t.home()} class="text-text no-underline hover:text-accent">
          <strong>{t.home()}</strong>
        </a>
        <nav aria-label={t.navMain()}>
          <ul class="flex flex-wrap gap-4">
            {nav.map((item) => (
              <li>
                <a href={item.href} lang={lang} class="text-text no-underline hover:text-accent">
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <LanguageSwitcher current={lang} />
      </div>
    </header>
    <main id="main" class="mx-auto max-w-content p-4 py-6">
      <slot />
    </main>
    <footer class="mt-8 border-t border-border bg-surface">
      <div class="mx-auto max-w-content p-4 py-6 text-sm text-text-secondary">
        <p>{t.footerNotice()}</p>
        <p lang={lang}>{t.footerDocs()}</p>
      </div>
    </footer>
  </body>
</html>
