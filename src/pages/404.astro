---
import SiteLayout from "../components/SiteLayout.astro";
import { ml } from "../lib/messages.ts";

const t = ml("ja");
---

<SiteLayout lang="ja" title={`${t.notFound()} — ${t.home()}`} canonicalPath="/404.html" noindex>
  <div class="py-8 text-center">
    <h1 class="text-2xl">{t.notFound()}</h1>
    <p>{t.notFoundBody()}</p>
    <nav aria-label="回到首页">
      <ul class="flex justify-center gap-3">
        <li><a href="/">{t.backHome()}</a></li>
        <li><a href="/zh/">中文</a></li>
        <li><a href="/ja/">日本語</a></li>
        <li><a href="/en/">English</a></li>
      </ul>
    </nav>
  </div>
</SiteLayout>
