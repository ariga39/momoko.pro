---
import PageIntro from "../../../components/PageIntro.astro";
import SiteLayout from "../../../components/SiteLayout.astro";
import { loadPublishedNews } from "../../../lib/content.ts";
import { loadPublishedProfiles } from "../../../lib/encyclopedia.ts";
import { isLocale } from "../../../lib/locale.ts";
import { ml, type Locale } from "../../../lib/messages.ts";
import { buildProfileSearchIndex, buildSearchIndex } from "../../../lib/search.ts";

const rawLang = Astro.params.lang;
if (!isLocale(rawLang)) return Astro.rewrite("/404");
const lang = rawLang as Locale;
const t = ml(lang);
export const prerender = false;
const searchPath = `/${lang}/search`;
const newsRows = buildSearchIndex(loadPublishedNews());
const profileRows = buildProfileSearchIndex(loadPublishedProfiles());
const index = [...newsRows, ...profileRows]
  .filter((row) => row.lang === lang)
  .sort((a, b) => a.path.localeCompare(b.path) || a.slug.localeCompare(b.slug));
---

<SiteLayout
  lang={lang}
  title={`${t.searchHeading()} · ${t.home()}`}
  canonicalPath={`/${lang}/search/`}
  noindex
>
  <PageIntro eyebrow="06 / index search" title={t.searchHeading()} lede={t.visualArchiveLede()} />
  <form class="filter-bar" id="site-search" method="get" action={searchPath} data-result-one={t.searchResultCountOne({ count: "{count}" })} data-result-other={t.searchResultCountOther({ count: "{count}" })}>
    <label class="filter-field grow" for="q">
      {t.searchQuery()}
      <input class="search-input w-full" id="q" type="search" name="q" autocomplete="off" />
    </label>
    <button class="button-secondary" type="submit">{t.visualSearch()}</button>
    <p id="search-status" class="filter-hint" aria-live="polite">{t.searchResultCountOther({ count: String(index.length) })}</p>
  </form>

  {index.length > 0 ? (
    <ul class="search-list" id="results">
      {index.map((row) => {
        const kindLabel = row.kind === "news" ? t.navNews() : t.navEncyclopedia();
        return (
          <li data-search-item data-search-text={`${row.title ?? ""} ${row.body ?? ""}`}>
            <a class="search-result" href={row.path} lang={row.lang}>
              <span class="card-eyebrow">{kindLabel}</span>
              <strong>{row.title}</strong>
              <span>{row.body}</span>
            </a>
          </li>
        );
      })}
    </ul>
  ) : (
    <section class="empty-state" aria-labelledby="search-empty-title">
      <h2 id="search-empty-title" class="section-title">{t.visualEmptyTitle()}</h2>
      <p class="mt-3 text-text-secondary">{t.visualEmptyBody()}</p>
    </section>
  )}
  <p id="search-no-results" class="empty-state" hidden>{t.searchNoResults()}</p>

  <script is:inline>
    const searchForm = document.getElementById("site-search");
    const searchInput = document.getElementById("q");
    const searchItems = [...document.querySelectorAll("[data-search-item]")];
    const searchStatus = document.getElementById("search-status");
    const searchEmpty = document.getElementById("search-no-results");
    const resultCount = (count) => {
      const one = searchForm?.getAttribute("data-result-one") ?? "{count} result";
      const other = searchForm?.getAttribute("data-result-other") ?? "{count} results";
      const template = count === 1 ? one : other;
      return template.replace("{count}", String(count));
    };
    const normalize = (value) => (value || "").toLocaleLowerCase();
    const renderSearch = () => {
      const query = normalize(searchInput?.value).trim();
      let visible = 0;
      searchItems.forEach((item) => {
        const matches = !query || normalize(item.dataset.searchText).includes(query);
        item.hidden = !matches;
        if (matches) visible += 1;
      });
      if (searchStatus) searchStatus.textContent = resultCount(visible);
      if (searchEmpty) searchEmpty.hidden = !query || visible > 0;
    };
    const searchParams = new URLSearchParams(window.location.search);
    if (searchInput) searchInput.value = searchParams.get("q") || "";
    searchForm?.addEventListener("input", renderSearch);
    renderSearch();
  </script>
</SiteLayout>
