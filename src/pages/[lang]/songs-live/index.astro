---
import DemoNotice from "../../../components/DemoNotice.astro";
import PageIntro from "../../../components/PageIntro.astro";
import SiteLayout from "../../../components/SiteLayout.astro";
import StatusPill from "../../../components/StatusPill.astro";
import { ml, type Locale } from "../../../lib/messages.ts";
import { loadVisualCatalog } from "../../../lib/visual-demo.ts";
import { parseFilterQuery } from "../../../lib/url-filter.ts";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "ja" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = ml(lang);
const catalog = loadVisualCatalog();
const years = [...new Set(catalog.songsLive.map((item) => String(item.year)))].sort().reverse();
const filter = parseFilterQuery(Astro.url.search);
const initialItems = catalog.songsLive.filter(
  (item) => (!filter.year || String(item.year) === filter.year) && (filter.type === "all" || item.kind === filter.type),
);
---

<SiteLayout lang={lang} title={`${t.navSongsLive()} · ${t.home()}`} canonicalPath={`/${lang}/songs-live/`}>
  <DemoNotice lang={lang} catalog={catalog} />
  <PageIntro eyebrow="04 / timeline" title={t.visualSongsLive()} lede={t.visualArchiveLede()} />
  <form class="filter-bar" id="songs-filter" method="get" action={`/${lang}/songs-live/`}>
    <label class="filter-field" for="songs-year">
      {t.visualYear()}
      <select id="songs-year" name="year">
        <option value="">{t.visualAll()}</option>
        {years.map((year) => <option value={year}>{year}</option>)}
      </select>
    </label>
    <label class="filter-field" for="songs-type">
      {t.visualType()}
      <select id="songs-type" name="type">
        <option value="all">{t.visualAll()}</option>
        <option value="song">{t.visualSong()}</option>
        <option value="live">{t.visualLive()}</option>
      </select>
    </label>
    <button class="button-secondary" type="submit">{t.visualResults()}</button>
    <p class="filter-hint" id="songs-filter-status" aria-live="polite">{initialItems.length} {t.visualResults()}</p>
  </form>
  {catalog.songsLive.length > 0 ? (
    <ol class="timeline-list" id="songs-timeline">
      {catalog.songsLive.map((item) => (
        <li data-timeline-card data-filter-year={item.year} data-filter-type={item.kind}>
          <article class="timeline-card">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <time datetime={item.date}>{item.date}</time>
              <StatusPill tone={item.kind === "live" ? "pink" : "brass"}>{item.kind === "live" ? t.visualLive() : t.visualSong()}</StatusPill>
            </div>
            <h2 class="card-title">{item.title[lang]}</h2>
            <p class="card-body">{item.note[lang]}</p>
            <p class="card-meta">{t.visualVenue()}: {item.venue[lang]}</p>
          </article>
        </li>
      ))}
    </ol>
  ) : (
    <section class="empty-state" aria-labelledby="songs-empty-title">
      <h2 id="songs-empty-title" class="section-title">{t.visualEmptyTitle()}</h2>
      <p class="mt-3 text-text-secondary">{t.visualEmptyBody()}</p>
    </section>
  )}
  <script is:inline>
    const songsForm = document.getElementById("songs-filter");
    const songsYear = document.getElementById("songs-year");
    const songsType = document.getElementById("songs-type");
    const songsCards = [...document.querySelectorAll("[data-timeline-card]")];
    const songsStatus = document.getElementById("songs-filter-status");
    const songsApply = () => {
      const year = songsYear?.value || "";
      const type = songsType?.value || "all";
      let visible = 0;
      songsCards.forEach((card) => {
        const matches = (!year || card.dataset.filterYear === year) && (type === "all" || card.dataset.filterType === type);
        card.hidden = !matches;
        if (matches) visible += 1;
      });
      if (songsStatus) songsStatus.textContent = `${visible} results`;
    };
    const songsParams = new URLSearchParams(window.location.search);
    if (songsYear) songsYear.value = /^\d{4}$/.test(songsParams.get("year") || "") ? songsParams.get("year") : "";
    if (songsType) songsType.value = ["all", "song", "live"].includes(songsParams.get("type") || "") ? songsParams.get("type") : "all";
    songsForm?.addEventListener("input", songsApply);
    songsApply();
  </script>
</SiteLayout>
