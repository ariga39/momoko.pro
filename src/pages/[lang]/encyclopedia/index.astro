---
import EditorialCard from "../../../components/EditorialCard.astro";
import PageIntro from "../../../components/PageIntro.astro";
import SiteLayout from "../../../components/SiteLayout.astro";
import { loadPublishedProfiles, resolveProfileLocale } from "../../../lib/encyclopedia.ts";
import { ml, type Locale } from "../../../lib/messages.ts";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "ja" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = ml(lang);
const profiles = loadPublishedProfiles().sort((a, b) => a.slug.localeCompare(b.slug));
---

<SiteLayout lang={lang} title={`${t.navEncyclopedia()} · ${t.home()}`} canonicalPath={`/${lang}/encyclopedia/`}>
  <PageIntro eyebrow="03 / dossier index" title={t.visualEncyclopedia()} lede={t.visualArchiveLede()} />
  {profiles.length > 0 ? (
    <ul class="archive-grid" aria-label={t.visualEncyclopedia()}>
      {profiles.map((profile) => {
        const resolved = resolveProfileLocale(profile, lang);
        const eyebrow = `${profile.canonical.sourceId} · ${resolved.facts.type}`;
        const meta = [
          resolved.facts.birthday,
          resolved.facts.height,
          resolved.facts.cv,
        ]
          .filter(Boolean)
          .join(" · ");
        return (
          <li>
            <EditorialCard
              eyebrow={eyebrow}
              title={resolved.title}
              body={resolved.facts.tagline}
              meta={meta}
              lang={lang}
            />
          </li>
        );
      })}
    </ul>
  ) : (
    <section class="empty-state" aria-labelledby="encyclopedia-empty-title">
      <h2 id="encyclopedia-empty-title" class="section-title">{t.visualEmptyTitle()}</h2>
      <p class="mt-3 text-text-secondary">{t.visualEmptyBody()}</p>
    </section>
  )}
</SiteLayout>
