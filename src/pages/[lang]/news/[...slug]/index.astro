---
import SiteLayout from "../../../../components/SiteLayout.astro";
import { hasTranslation, loadNews, resolveLocale } from "../../../../lib/content.ts";
import * as m from "../../../../paraglide/messages.js";

export function getStaticPaths() {
  const paths = [];
  for (const item of loadNews()) {
    for (const lang of ["zh", "ja", "en"]) {
      paths.push({ params: { lang, slug: item.slug } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: "ja" | "zh" | "en"; slug: string | undefined };
const slugPath = slug ?? "";
const item = loadNews().find((i) => i.slug === slugPath);
const locale = item ? resolveLocale(item, lang) : undefined;
const translated = item ? hasTranslation(item, lang) : false;
// 真实翻译页 vs fallback 页（i18n §1.2）：fallback 用源语言 canonical + noindex,follow。
const sourceLang = item?.canonical.lang ?? "ja";
const alternates = ["zh", "ja", "en"].map((l) => ({
  hreflang: l,
  href: `https://momoko.pro/${l}/news/${item?.slug}/`,
}));
---

<SiteLayout
  lang={translated ? lang : sourceLang}
  title={item?.canonical.title ?? m.home()}
  canonicalPath={translated ? `/${lang}/news/${item?.slug}/` : `/${sourceLang}/news/${item?.slug}/`}
  {...(translated ? { alternates } : {})}
  {...(translated ? {} : { robots: "noindex,follow" as const })}
>
  {item && locale ? (
    <>
      <p><a href={`/${lang}/`}>{m["news.backToList"]()}</a></p>
      <h1 class="text-2xl" lang={translated ? lang : sourceLang}>{item.canonical.title}</h1>
      <p>
        <time datetime={item.canonical.publishedAt} class="text-sm text-text-secondary">
          {item.canonical.publishedAt}
        </time>
        {!translated && (
          <span class="ml-2 border-l-[3px] border-accent pl-3 text-sm text-text-secondary">
            {m["news.missingLocale"]()}
          </span>
        )}
      </p>
      <p class="text-sm text-text-secondary">
        {m["news.riskTier"]({ tier: item.canonical.riskTier })} · {m["news.reviewStatus"]({ status: item.canonical.reviewStatus })} ·{" "}
        {m["news.source"]({ source: item.canonical.sourceId })}
      </p>
      <article>{locale.body}</article>
    </>
  ) : (
    <p>{m["news.empty"]()}</p>
  )}
</SiteLayout>
