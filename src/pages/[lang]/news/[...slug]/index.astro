---
import SiteLayout from "../../../../components/SiteLayout.astro";
import { hasTranslation, loadNews, resolveLocale } from "../../../../lib/content.ts";
import { ml, type Locale } from "../../../../lib/messages.ts";

export function getStaticPaths() {
  const paths = [];
  for (const item of loadNews()) {
    for (const lang of ["zh", "ja", "en"]) {
      paths.push({ params: { lang, slug: item.slug } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: Locale; slug: string | undefined };
const slugPath = slug ?? "";
const item = loadNews().find((i) => i.slug === slugPath);
const t = ml(lang);
const locale = item ? resolveLocale(item, lang) : undefined;
const translated = item ? hasTranslation(item, lang) : false;
const sourceLang = item?.canonical.lang ?? "ja";
// 源语言页面（lang===canonical.lang）本身就是内容身份的源页面：
// self-canonical、按内容状态索引、不显示缺译提示、不 noindex/follow。
// 仅「非源语言请求且无真实译文」才是 fallback 页（noindex,follow + 缺译提示）。
const isSourcePage = item ? lang === sourceLang : false;
const isFallback = !isSourcePage && !translated;
const effectiveLang = translated || isSourcePage ? lang : sourceLang;
// 源语言页 robots 按内容状态：reviewed→可索引；draft/stale→noindex,follow。
const sourceRobots =
  item?.canonical.reviewStatus === "reviewed" ? undefined : ("noindex,follow" as const);

// 内容身份 alternate 集合（design §1.2）：只含源语言页 + 真实翻译页，
// 缺译的请求 locale 不得进入集合；x-default 指向源语言页。
const contentAlternates = item
  ? (["ja", "zh", "en"] as Locale[])
      .filter((l) => l === sourceLang || hasTranslation(item, l))
      .map((l) => ({
        hreflang: l,
        href: `https://momoko.pro/${l}/news/${item.slug}/`,
      }))
  : [];
---

<SiteLayout
  lang={effectiveLang}
  title={item?.canonical.title ?? t.home()}
  canonicalPath={`/${effectiveLang}/news/${item?.slug}/`}
  alternates={contentAlternates}
  {...(isFallback ? { robots: "noindex,follow" as const } : isSourcePage && sourceRobots ? { robots: sourceRobots } : {})}
  {...(item ? { xDefaultHref: `https://momoko.pro/${sourceLang}/news/${item.slug}/` } : {})}
>
  {item && locale ? (
    <>
      <p><a href={`/${lang}/`}>{t.newsBackToList()}</a></p>
      <h1 class="text-2xl" lang={effectiveLang}>{item.canonical.title}</h1>
      <p>
        <time datetime={item.canonical.publishedAt} class="text-sm text-text-secondary">
          {item.canonical.publishedAt}
        </time>
        {isFallback && (
          <span class="ml-2 border-l-[3px] border-accent pl-3 text-sm text-text-secondary">
            {t.newsMissingLocale()}
          </span>
        )}
      </p>
      <p class="text-sm text-text-secondary">
        {t.newsRiskTier({ tier: item.canonical.riskTier })} · {t.newsReviewStatus({ status: item.canonical.reviewStatus })} ·{" "}
        {t.newsSource({ source: item.canonical.sourceId })}
      </p>
      <article>{locale.body}</article>
    </>
  ) : (
    <p>{t.newsEmpty()}</p>
  )}
</SiteLayout>
