---
import DemoNotice from "../../../../components/DemoNotice.astro";
import SiteLayout from "../../../../components/SiteLayout.astro";
import { hasTranslation, isCurrentReviewed, isRetracted, loadNews, resolveLocale } from "../../../../lib/content.ts";
import { ml, type Locale } from "../../../../lib/messages.ts";
import { loadVisualCatalog } from "../../../../lib/visual-demo.ts";

export function getStaticPaths() {
  const paths = [];
  const lifecyclePreview = process.env.MOMOKO_CONTENT_PACKAGE_PREVIEW === "1";
  const candidates = lifecyclePreview
    ? loadNews().filter((candidate) => !isRetracted(candidate))
    : loadNews().filter(isCurrentReviewed);
  for (const item of candidates) {
    for (const lang of ["zh", "ja", "en"]) {
      paths.push({ params: { lang, slug: item.slug } });
    }
  }
  return paths;
}

const { lang, slug } = Astro.params as { lang: Locale; slug: string | undefined };
const slugPath = slug ?? "";
const item = loadNews().find((i) => i.slug === slugPath);
const retracted = item ? isRetracted(item) : false;
const t = ml(lang);
const catalog = loadVisualCatalog();
const locale = item && !retracted ? resolveLocale(item, lang) : undefined;
const translated = item && !retracted ? hasTranslation(item, lang) : false;
const sourceLang = item?.canonical.lang ?? "ja";
// The source-language page is the content identity page: it is self-canonical,
// follows content status, and never displays a missing-translation notice.
// Only a non-source request without a real translation is a fallback page.
const isSourcePage = item ? lang === sourceLang : false;
const isFallback = !isSourcePage && !translated;
const effectiveLang = translated || isSourcePage ? lang : sourceLang;
// Source-language robots follow lifecycle status.
const sourceRobots =
  item?.canonical.reviewStatus === "reviewed" ? undefined : ("noindex,follow" as const);

// Content alternates include only the source page and real translations.
const contentAlternates = item
  ? (["ja", "zh", "en"] as Locale[])
      .filter((l) => l === sourceLang || hasTranslation(item, l))
      .map((l) => ({
        hreflang: l,
        href: `https://momoko.pro/${l}/news/${item.slug}/`,
      }))
  : [];
---

<SiteLayout
  lang={effectiveLang}
  title={item?.canonical.title ?? t.home()}
  canonicalPath={`/${effectiveLang}/news/${item?.slug}/`}
  alternates={contentAlternates}
  {...(isFallback ? { robots: "noindex,follow" as const } : isSourcePage && sourceRobots ? { robots: sourceRobots } : {})}
  {...(item ? { xDefaultHref: `https://momoko.pro/${sourceLang}/news/${item.slug}/` } : {})}
>
  <DemoNotice lang={effectiveLang} catalog={catalog} />
  {item && !retracted && locale ? (
    <>
      <p class="mb-6"><a href={`/${lang}/news/`}>{t.newsBackToList()}</a></p>
      <article class="detail-layout">
        <aside class="detail-meta" aria-label="Content metadata">
          <p class="eyebrow">{item.canonical.publishedAt.slice(0, 10)}</p>
          <p>{t.newsRiskTier({ tier: item.canonical.riskTier })}</p>
          <p>{t.newsReviewStatus({ status: item.canonical.reviewStatus })}</p>
          <p>{t.newsSource({ source: item.canonical.sourceId })}</p>
          {isFallback && <p class="fallback-note">{t.newsMissingLocale()}</p>}
        </aside>
        <div class="detail-body">
          <h1 class="display-title" lang={effectiveLang}>{item.canonical.title}</h1>
          <p class="detail-date">
            <time datetime={item.canonical.publishedAt}>{item.canonical.publishedAt}</time>
          </p>
          <div class="prose-block" lang={effectiveLang}>{locale.body}</div>
          <div class="detail-callout">
            <p class="card-eyebrow">{t.visualSourcePolicy()}</p>
            <p>{t.policyCorrectionBody()}</p>
          </div>
        </div>
      </article>
    </>
  ) : (
    <section class="empty-state" aria-labelledby="missing-news-title">
      <p class="eyebrow">{t.visualArchiveEyebrow()}</p>
      <h1 id="missing-news-title" class="section-title">{t.visualEmptyTitle()}</h1>
      <p class="mt-3 text-text-secondary">{t.newsEmpty()}</p>
    </section>
  )}
</SiteLayout>
