---
import SiteLayout from "../../../components/SiteLayout.astro";
import { loadNews } from "../../../lib/content.ts";
import { ml, type Locale } from "../../../lib/messages.ts";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "ja" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = ml(lang);
const sources = loadNews();
---

<SiteLayout lang={lang} title={`${t.policyTitle()} · ${t.home()}`} canonicalPath={`/${lang}/source-policy/`}>
  <h1 class="text-2xl">{t.policyTitle()}</h1>
  <p>{t.policyIntro()}</p>
  <ul class="list-disc pl-6">
    <li>{t.policyNoCopy()}</li>
    <li>{t.policyAutomated()}</li>
  </ul>
  <h2 class="text-xl">{t.policyCurrentSources()}</h2>
  <ul class="list-disc pl-6">
    {sources.map((s) => (
      <li>
        <strong>{s.canonical.sourceId}</strong> — {s.canonical.sourceUrl}
      </li>
    ))}
  </ul>
</SiteLayout>
