---
import SiteLayout from "../../../components/SiteLayout.astro";
import { ml, type Locale } from "../../../lib/messages.ts";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "ja" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = ml(lang);
---

<SiteLayout lang={lang} title={`${t.aboutTitle()} · ${t.home()}`} canonicalPath={`/${lang}/about/`}>
  <h1 class="text-2xl">{t.aboutTitle()}</h1>
  <p lang={lang}>{t.aboutBody()}</p>
</SiteLayout>
