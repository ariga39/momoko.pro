---
import DemoNotice from "../components/DemoNotice.astro";
import PageIntro from "../components/PageIntro.astro";
import SiteLayout from "../components/SiteLayout.astro";
import { loadPublishedNews } from "../lib/content.ts";
import { ml } from "../lib/messages.ts";
import { buildSearchIndex } from "../lib/search.ts";
import { loadVisualCatalog } from "../lib/visual-demo.ts";

const t = ml("ja");
const catalog = loadVisualCatalog();
const items = loadPublishedNews().sort((a, b) => b.canonical.publishedAt.localeCompare(a.canonical.publishedAt));
const index = buildSearchIndex(items);
---

<SiteLayout
  lang="ja"
  title={`${t.searchHeading()} · ${t.home()}`}
  canonicalPath="/search"
  noindex
>
  <DemoNotice lang="ja" catalog={catalog} />
  <PageIntro eyebrow="06 / index search" title={t.searchHeading()} lede={t.visualArchiveLede()} />
  <form class="filter-bar" id="site-search" method="get" action="/search">
    <label class="filter-field grow" for="q">
      {t.searchQuery()}
      <input class="search-input w-full" id="q" type="search" name="q" autocomplete="off" />
    </label>
    <button class="button-secondary" type="submit">{t.visualSearch()}</button>
    <p id="search-status" class="filter-hint" aria-live="polite">{index.length} {t.visualResults()}</p>
  </form>

  {index.length > 0 ? (
    <ul class="search-list" id="results">
      {index.map((row) => {
        return (
          <li data-search-item data-search-text={`${row.title ?? ""} ${row.body ?? ""} ${row.sourceId}`}>
            <a class="search-result" href={row.path} lang={row.lang}>
              <span class="card-eyebrow">{row.sourceId} · {row.lang}</span>
              <span class="sr-only">{row.sourceId}-{row.sourceItemId}</span>
              <strong>{row.title}</strong>
              <span>{row.body}</span>
            </a>
          </li>
        );
      })}
    </ul>
  ) : (
    <section class="empty-state" aria-labelledby="search-empty-title">
      <h2 id="search-empty-title" class="section-title">{t.visualEmptyTitle()}</h2>
      <p class="mt-3 text-text-secondary">{t.visualEmptyBody()}</p>
    </section>
  )}
  <p id="search-no-results" class="empty-state" hidden>{t.searchNoResults()}</p>

  <script is:inline>
    const searchForm = document.getElementById("site-search");
    const searchInput = document.getElementById("q");
    const searchItems = [...document.querySelectorAll("[data-search-item]")];
    const searchStatus = document.getElementById("search-status");
    const searchEmpty = document.getElementById("search-no-results");
    const normalize = (value) => (value || "").toLocaleLowerCase();
    const renderSearch = () => {
      const query = normalize(searchInput?.value).trim();
      let visible = 0;
      searchItems.forEach((item) => {
        const matches = !query || normalize(item.dataset.searchText).includes(query);
        item.hidden = !matches;
        if (matches) visible += 1;
      });
      if (searchStatus) searchStatus.textContent = `${visible} results`;
      if (searchEmpty) searchEmpty.hidden = !query || visible > 0;
    };
    const searchParams = new URLSearchParams(window.location.search);
    if (searchInput) searchInput.value = searchParams.get("q") || "";
    searchForm?.addEventListener("input", renderSearch);
    renderSearch();
  </script>
</SiteLayout>
