---
import { resolveRequestLocale, LOCALE_COOKIE_NAME } from "../lib/locale.ts";

export const prerender = false;

const destination = `/${resolveRequestLocale(
  Astro.cookies.get(LOCALE_COOKIE_NAME)?.value,
  Astro.request.headers.get("accept-language"),
)}/`;

Astro.response.status = 302;
Astro.response.headers.set("location", destination);
---
