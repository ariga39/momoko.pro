---
import { hasTranslation, loadNews, resolveLocale } from "../lib/content.ts";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "ja" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: "zh" | "ja" | "en" };
const items = loadNews();
const entries = items
  .map((item) => ({ item, locale: resolveLocale(item, lang) }))
  .sort((a, b) => b.item.canonical.publishedAt.localeCompare(a.item.canonical.publishedAt));

const langNames = { zh: "中文", ja: "日本語", en: "English" } as const;
const canonical = `https://momoko.pro/${lang}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="alternate" hreflang="zh" href="https://momoko.pro/zh" />
    <link rel="alternate" hreflang="ja" href="https://momoko.pro/ja" />
    <link rel="alternate" hreflang="en" href="https://momoko.pro/en" />
    <link rel="alternate" hreflang="x-default" href="https://momoko.pro/" />
    <link rel="canonical" href={canonical} />
    <title>{langNames[lang]} · momoko.pro</title>
  </head>
  <body>
    <h1>{langNames[lang]} · momoko.pro</h1>
    <nav>
      <ul>
        <li><a href="/zh" hreflang="zh" lang="zh">中文</a></li>
        <li><a href="/ja" hreflang="ja" lang="ja">日本語</a></li>
        <li><a href="/en" hreflang="en" lang="en">English</a></li>
      </ul>
    </nav>
    <main>
      <h2>{langNames[lang]} 新闻列表</h2>
      {entries.length === 0 ? (
        <p>暂无内容。</p>
      ) : (
        <ul>
          {entries.map(({ item, locale }) => (
            <li>
              <a href={`/${lang}/news/${item.slug}/`} lang={lang}>
                {item.canonical.title}
              </a>
              <span> · {item.canonical.publishedAt}</span>
              {!hasTranslation(item, lang) && <span> ·（缺译回退源语言）</span>}
            </li>
          ))}
        </ul>
      )}
    </main>
  </body>
</html>
