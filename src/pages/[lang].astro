---
import SiteLayout from "../components/SiteLayout.astro";
import NewsList from "../components/NewsList.astro";
import * as m from "../paraglide/messages.js";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "ja" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: "ja" | "zh" | "en" };
const langNames = { zh: m["lang.zh"](), ja: m["lang.ja"](), en: m["lang.en"]() };
---

<SiteLayout lang={lang} title={`${langNames[lang]} · ${m.home()}`} canonicalPath={`/${lang}/`}>
  <h1 class="text-2xl">{langNames[lang]} · {m.home()}</h1>
  <h2 class="text-xl">{m["news.heading"]()}</h2>
  <NewsList lang={lang} />
</SiteLayout>
