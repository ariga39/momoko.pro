---
import { getRelativeLocaleUrl } from "astro:i18n";
import DemoNotice from "../components/DemoNotice.astro";
import EditorialCard from "../components/EditorialCard.astro";
import SiteLayout from "../components/SiteLayout.astro";
import { loadPublishedNews, resolveLocale } from "../lib/content.ts";
import { ml, type Locale } from "../lib/messages.ts";
import { loadVisualCatalog } from "../lib/visual-demo.ts";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "ja" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = ml(lang);
const catalog = loadVisualCatalog();
const news = loadPublishedNews().sort((a, b) => b.canonical.publishedAt.localeCompare(a.canonical.publishedAt));
const featured = news.slice(0, 3);
const profile = [
  [t.profileAge(), t.profileAgeValue()],
  [t.profileBirthday(), t.profileBirthdayValue()],
  [t.profileBloodType(), t.profileBloodTypeValue()],
  [t.profileHeight(), t.profileHeightValue()],
  [t.profileOrigin(), t.profileOriginValue()],
  [t.profileHobby(), t.profileHobbyValue()],
  [t.profileVoice(), t.profileVoiceValue()],
];
const chapterLinks = [
  {
    code: "01",
    word: "STORIES",
    label: t.homeStories(),
    href: getRelativeLocaleUrl(lang, "/news/"),
  },
  {
    code: "02",
    word: "SONGS",
    label: t.homeSongs(),
    href: getRelativeLocaleUrl(lang, "/songs-live/"),
  },
  {
    code: "03",
    word: "LITTLE THINGS",
    label: t.homeLittleThings(),
    href: getRelativeLocaleUrl(lang, "/encyclopedia/"),
  },
];
---

<SiteLayout
  lang={lang}
  title={`${t.home()} · ${t.profileTitle()}`}
  description={t.homeTagline()}
  canonicalPath={`/${lang}/`}
  bodyData={{ "data-page": "home", "data-visual-contract": "v0.5" }}
>
  <div class="home-v05" data-home-v05>
    <div class="folio-spectrum" aria-hidden="true">
      <span class="folio-spectrum-pink"></span>
      <span class="folio-spectrum-blue"></span>
      <span class="folio-spectrum-brass"></span>
      <span class="folio-spectrum-pale"></span>
      <span class="folio-spectrum-navy"></span>
    </div>

    <div class="folio-layout" data-folio-layout>
      <aside class="folio-spine" aria-label={t.homeFolioLabel()}>
        <div class="folio-spine-number" aria-hidden="true">049</div>
        <div class="folio-spine-facts">
          <div>
            <span>{t.profileAge()}</span>
            <strong>{t.profileAgeValue()}</strong>
          </div>
          <div>
            <span>{t.profileBirthday()}</span>
            <strong>{t.profileBirthdayValue()}</strong>
          </div>
          <div>
            <span>{t.homeFolioColor()}</span>
            <strong class="folio-color-value">#EFB864</strong>
          </div>
        </div>
        <div class="folio-suits" aria-hidden="true">
          <span>♠</span><span>♥</span><span>♦</span><span>♣</span>
        </div>
      </aside>

      <section class="folio-sheet" aria-labelledby="momoko-name">
        <div class="folio-sheet-heading">
          <p class="folio-eyebrow">{t.profileEyebrow()}</p>
          <span class="folio-issue">049 / 2026</span>
        </div>
        <h1 id="momoko-name" class="folio-name">
          <span lang="ja">周防</span>
          <span lang="ja">桃子</span>
        </h1>
        <p class="folio-name-latin">MOMOKO SUOU</p>
        <div class="folio-rule" aria-hidden="true"><span>♥</span></div>
        <p class="folio-intro">{t.homeIntro()}</p>
        <p class="folio-tagline">{t.homeTagline()}</p>
      </section>

      <aside class="folio-chapter" aria-labelledby="opening-note-title">
        <p class="folio-chapter-label">{t.homeChapterOpening()}</p>
        <h2 id="opening-note-title">{t.profileTitle()}</h2>
        <p class="folio-chapter-lede">{t.profileIntro()}</p>
        <a
          class="folio-source-link"
          href="https://millionlive-anime.idolmaster-official.jp/character/momoko/"
          rel="external noreferrer"
        >{t.profileSource()} <span aria-hidden="true">↗</span></a>

        <dl class="folio-facts">
          {profile.map(([term, value]) => (
            <div>
              <dt>{term}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>

        <a class="folio-song-card" href={getRelativeLocaleUrl(lang, "/songs-live/")}>
          <span class="folio-song-card-kicker">02 / {t.homeChapterSong()}</span>
          <strong>{t.navSongsLive()}</strong>
          <span aria-hidden="true">↗</span>
        </a>
      </aside>
    </div>

    <nav class="chapter-index" aria-labelledby="chapter-index-title" data-chapter-index>
      <h2 id="chapter-index-title" class="sr-only">{t.homeChapterIndex()}</h2>
      {chapterLinks.map((chapter) => (
        <a class="chapter-index-link" href={chapter.href}>
          <span class="chapter-index-code">{chapter.code}</span>
          <span class="chapter-index-copy">
            <span class="chapter-index-word">{chapter.word}</span>
            <strong>{chapter.label}</strong>
          </span>
          <span class="chapter-index-arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </nav>

    <section class="home-notes" aria-labelledby="notes-title">
      <DemoNotice lang={lang} catalog={catalog} />
      <div class="home-notes-heading">
        <div>
          <p class="folio-eyebrow">{t.visualArchiveEyebrow()}</p>
          <h2 id="notes-title">{t.visualLatest()}</h2>
        </div>
        <a href={getRelativeLocaleUrl(lang, "/news/")}>{t.visualArchive()} <span aria-hidden="true">↗</span></a>
      </div>
      {featured.length > 0 ? (
        <div class="card-grid">
          {featured.map((item) => {
            const resolved = resolveLocale(item, lang);
            return (
              <EditorialCard
                href={`/${lang}/news/${item.slug}/`}
                eyebrow={item.canonical.publishedAt.slice(0, 10)}
                title={item.canonical.title}
                body={resolved.body}
                meta={`${item.canonical.sourceId} · ${resolved.translated ? lang : item.canonical.lang}`}
                lang={lang}
              />
            );
          })}
        </div>
      ) : (
        <section class="home-empty" aria-labelledby="home-empty-title">
          <p class="folio-eyebrow">{t.visualArchiveEyebrow()}</p>
          <h3 id="home-empty-title">{t.visualEmptyTitle()}</h3>
          <p>{t.visualEmptyBody()}</p>
        </section>
      )}
    </section>
  </div>
</SiteLayout>
