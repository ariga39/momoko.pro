---
import SiteLayout from "../components/SiteLayout.astro";
import NewsList from "../components/NewsList.astro";
import { ml, type Locale } from "../lib/messages.ts";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "ja" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = ml(lang);
const langNames = { zh: t.langZh(), ja: t.langJa(), en: t.langEn() };
---

<SiteLayout lang={lang} title={`${langNames[lang]} · ${t.home()}`} canonicalPath={`/${lang}/`}>
  <h1 class="text-2xl">{langNames[lang]} · {t.home()}</h1>
  <h2 class="text-xl">{t.newsHeading()}</h2>
  <NewsList lang={lang} />
</SiteLayout>
