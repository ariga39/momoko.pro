---
import { getRelativeLocaleUrl } from "astro:i18n";
import DemoNotice from "../components/DemoNotice.astro";
import EditorialCard from "../components/EditorialCard.astro";
import PageIntro from "../components/PageIntro.astro";
import SectionHeading from "../components/SectionHeading.astro";
import SiteLayout from "../components/SiteLayout.astro";
import { loadPublishedNews, resolveLocale } from "../lib/content.ts";
import { ml, type Locale } from "../lib/messages.ts";
import { loadVisualCatalog } from "../lib/visual-demo.ts";

export function getStaticPaths() {
  return [
    { params: { lang: "zh" } },
    { params: { lang: "ja" } },
    { params: { lang: "en" } },
  ];
}

const { lang } = Astro.params as { lang: Locale };
const t = ml(lang);
const catalog = loadVisualCatalog();
const news = loadPublishedNews().sort((a, b) => b.canonical.publishedAt.localeCompare(a.canonical.publishedAt));
const langNames = { zh: t.langZh(), ja: t.langJa(), en: t.langEn() };
const featured = news.slice(0, 3);
const profile = [
  [t.profileAge(), t.profileAgeValue()],
  [t.profileBirthday(), t.profileBirthdayValue()],
  [t.profileBloodType(), t.profileBloodTypeValue()],
  [t.profileHeight(), t.profileHeightValue()],
  [t.profileOrigin(), t.profileOriginValue()],
  [t.profileHobby(), t.profileHobbyValue()],
  [t.profileVoice(), t.profileVoiceValue()],
];
---

<SiteLayout lang={lang} title={`${langNames[lang]} · ${t.home()}`} canonicalPath={`/${lang}/`}>
  <PageIntro eyebrow={t.profileEyebrow()} title="周防桃子" lede={t.homeTagline()} />

  <section class="profile-section" aria-labelledby="momoko-profile-title">
    <div class="profile-copy">
      <h2 id="momoko-profile-title" class="section-title">{t.profileTitle()}</h2>
      <p>{t.profileIntro()}</p>
      <a
        href="https://millionlive-anime.idolmaster-official.jp/character/momoko/"
        rel="external noreferrer"
      >{t.profileSource()} <span aria-hidden="true">↗</span></a>
    </div>
    <dl class="profile-facts">
      {profile.map(([term, value]) => (
        <div>
          <dt>{term}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="mt-12" aria-labelledby="latest-heading">
    <DemoNotice lang={lang} catalog={catalog} />
    <SectionHeading
      eyebrow="01 / desk notes"
      title={t.visualLatest()}
      href={getRelativeLocaleUrl(lang, "/news/")}
      linkLabel={t.visualArchive()}
    />
    {featured.length > 0 ? (
      <div class="card-grid">
        {featured.map((item) => {
          const resolved = resolveLocale(item, lang);
          return (
            <EditorialCard
              href={`/${lang}/news/${item.slug}/`}
              eyebrow={item.canonical.publishedAt.slice(0, 10)}
              title={item.canonical.title}
              body={resolved.body}
              meta={`${item.canonical.sourceId} · ${resolved.translated ? lang : item.canonical.lang}`}
              lang={lang}
            />
          );
        })}
      </div>
    ) : (
      <section class="empty-state" aria-labelledby="home-empty-title">
        <p class="eyebrow">{t.visualArchiveEyebrow()}</p>
        <h3 id="home-empty-title" class="section-title">{t.visualEmptyTitle()}</h3>
        <p class="mt-3 max-w-prose text-text-secondary">{t.visualEmptyBody()}</p>
      </section>
    )}
  </section>

  <section class="mt-12" aria-labelledby="index-heading">
    <SectionHeading eyebrow="02 / index" title={t.visualEncyclopedia()} />
    <div class="quick-links-grid" id="index-heading">
      <a class="quick-link" href={getRelativeLocaleUrl(lang, "/encyclopedia/")}>
        <span class="quick-link-index">A</span>
        <span><strong>{t.navEncyclopedia()}</strong><small>{catalog.encyclopedia.length} entries</small></span>
        <span aria-hidden="true">↗</span>
      </a>
      <a class="quick-link" href={getRelativeLocaleUrl(lang, "/songs-live/")}>
        <span class="quick-link-index">B</span>
        <span><strong>{t.navSongsLive()}</strong><small>{catalog.songsLive.length} entries</small></span>
        <span aria-hidden="true">↗</span>
      </a>
      <a class="quick-link" href={getRelativeLocaleUrl(lang, "/anniversary/")}>
        <span class="quick-link-index">C</span>
        <span><strong>{t.navAnniversary()}</strong><small>{catalog.anniversaries.length} entries</small></span>
        <span aria-hidden="true">↗</span>
      </a>
      <a class="quick-link" href="/search">
        <span class="quick-link-index">D</span>
        <span><strong>{t.visualSearch()}</strong><small>{news.length} searchable notes</small></span>
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</SiteLayout>
